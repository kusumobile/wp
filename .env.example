WORDPRESS_DB_HOST=your-do-postgres-host:25060
WORDPRESS_DB_NAME=your_database_name
WORDPRESS_DB_USER=your_database_user
WORDPRESS_DB_PASSWORD=
WORDPRESS_URL=http://localhost:8080
WORDPRESS_SITE_TITLE=WordPress on DigitalOcean
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_ADMIN_EMAIL=admin@example.com

S3_UPLOADS_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_UPLOADS_PATH_STYLE=true
S3_UPLOADS_CHECKSUM_MODE=when_required

# Secret file paths are mounted by Compose from ./secrets/*.txt
# Create these files before running the stack.

S3_UPLOADS_BUCKET=your-space-name
S3_UPLOADS_REGION=nyc3
S3_UPLOADS_BUCKET_URL=https://your-space-name.nyc3.digitaloceanspaces.com
S3_UPLOADS_OBJECT_ACL=public-read
S3_UPLOADS_KEY=
S3_UPLOADS_SECRET=