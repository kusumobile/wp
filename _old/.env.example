POSTGRES_DB=wordpress
POSTGRES_USER=wordpress
POSTGRES_PASSWORD=wordpress

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_URL=http://localhost:8080
WORDPRESS_SITE_TITLE=WordPress on Postgres
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_EMAIL=admin@example.com

S3_UPLOADS_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_UPLOADS_PATH_STYLE=true
S3_UPLOADS_CHECKSUM_MODE=when_required

# Secret file paths are mounted by Compose from ./secrets/*.txt
# Create these files before running the stack.

S3_UPLOADS_BUCKET=
S3_UPLOADS_REGION=
S3_UPLOADS_KEY=
S3_UPLOADS_SECRET=
S3_UPLOADS_BUCKET_URL=
S3_UPLOADS_OBJECT_ACL=public-read